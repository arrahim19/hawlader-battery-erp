{
  "name": "hawlader-battery-erp",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n API,WEB -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace @hawlader/web",
    "dev:api": "npm run dev --workspace @hawlader/api",
    "build": "npm run db:generate && npm run build --workspace @hawlader/api && npm run build --workspace @hawlader/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "node scripts/run-integration.mjs",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/validate-phase1.mjs",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:generate": "prisma generate --config packages/database/prisma7.config.ts",
    "db:validate": "prisma validate --config packages/database/prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/database/prisma7.config.ts",
    "db:admin": "tsx --tsconfig apps/api/tsconfig.json scripts/create-admin.ts",
    "setup": "node scripts/setup-env.mjs",
    "verify": "node scripts/verify.mjs",
    "postinstall": "npm run db:generate",
    "format": "prettier --write apps/**/*.{ts,tsx,css,json,mjs} packages/api-client/**/*.ts scripts/*.{mjs,ts} tests/**/*.ts *.json *.mjs *.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
