{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hawlader-battery-erp",
  "account_id": "41b2175b95eeb040ec1b4da3c20c8085",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "HawladerERP",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../../Dockerfile",
          "build_context": "../..",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ERP", "class_name": "HawladerERP" }],
  },
  "exports": {
    "HawladerERP": { "type": "durable-object", "storage": "sqlite" },
  },
}
