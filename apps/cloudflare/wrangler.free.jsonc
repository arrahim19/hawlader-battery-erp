{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hawlader-battery-erp",
  "account_id": "41b2175b95eeb040ec1b4da3c20c8085",
  "main": "src/free.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/products",
      "/products/*",
      "/inventory/new",
      "/inventory/list",
      "/",
    ],
  },
}
