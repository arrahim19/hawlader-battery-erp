{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODE_OPTIONS": "--experimental-require-module"
  },
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "functions": {
        "src/main.ts": {
          "includeFiles": "../../node_modules/{argon2,node-gyp-build,@phc/format}/**"
        }
      },
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run db:generate && npm run build --workspace @hawlader/api"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "npm run build"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "web" }
    }
  ]
}
