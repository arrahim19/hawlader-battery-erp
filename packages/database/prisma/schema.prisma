  customerId        String?             @db.Uuid
  supplierId        String?             @db.Uuid
  assetAccountId    String              @db.Uuid
  journalId         String              @unique @db.Uuid
  reversedPaymentId String?             @unique @db.Uuid
  customer          Customer?           @relation("Payment_customer", fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier?           @relation("Payment_supplier", fields: [supplierId], references: [id], onDelete: Restrict)
  assetAccount      Account             @relation("Payment_assetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  journal           JournalEntry        @relation("Payment_journal", fields: [journalId], references: [id], onDelete: Restrict)
  reversedPayment   Payment?            @relation("Payment_reversedPayment", fields: [reversedPaymentId], references: [id], onDelete: Restrict)
  reversal          Payment?            @relation("Payment_reversedPayment")
  allocations       PaymentAllocation[] @relation("PaymentAllocation_payment")
}

model PaymentAllocation {
  id                   String             @id @default(uuid()) @db.Uuid
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  amount               Decimal            @db.Decimal(20, 2)
  paymentId            String             @db.Uuid
  saleId               String?            @db.Uuid
  purchaseReceiptId    String?            @db.Uuid
  reversedAllocationId String?            @unique @db.Uuid
  payment              Payment            @relation("PaymentAllocation_payment", fields: [paymentId], references: [id], onDelete: Restrict)
  sale                 Sale?              @relation("PaymentAllocation_sale", fields: [saleId], references: [id], onDelete: Restrict)
  purchaseReceipt      PurchaseReceipt?   @relation("PaymentAllocation_purchaseReceipt", fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  reversedAllocation   PaymentAllocation? @relation("PaymentAllocation_reversedAllocation", fields: [reversedAllocationId], references: [id], onDelete: Restrict)
  reversal             PaymentAllocation? @relation("PaymentAllocation_reversedAllocation")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  name      String    @unique
  active    Boolean   @default(true)
  accountId String    @db.Uuid
  account   Account   @relation("ExpenseCategory_account", fields: [accountId], references: [id], onDelete: Restrict)
  expenses  Expense[] @relation("Expense_category")
}

model Expense {
  id                String              @id @default(uuid()) @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  description       String
  amount            Decimal             @db.Decimal(20, 2)
  incurredDate      DateTime            @db.Date
  version           Int                 @default(1)
  categoryId        String              @db.Uuid
  journalId         String              @unique @db.Uuid
  reversedExpenseId String?             @unique @db.Uuid
  category          ExpenseCategory     @relation("Expense_category", fields: [categoryId], references: [id], onDelete: Restrict)
  journal           JournalEntry        @relation("Expense_journal", fields: [journalId], references: [id], onDelete: Restrict)
  reversedExpense   Expense?            @relation("Expense_reversedExpense", fields: [reversedExpenseId], references: [id], onDelete: Restrict)
  reversal          Expense?            @relation("Expense_reversedExpense")
  settlements       ExpenseSettlement[] @relation("ExpenseSettlement_expense")
}

model ExpenseSettlement {
  id                   String             @id @default(uuid()) @db.Uuid
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  amount               Decimal            @db.Decimal(20, 2)
  settledAt            DateTime           @db.Timestamptz(3)
  expenseId            String             @db.Uuid
  assetAccountId       String             @db.Uuid
  journalId            String             @unique @db.Uuid
  reversedSettlementId String?            @unique @db.Uuid
  expense              Expense            @relation("ExpenseSettlement_expense", fields: [expenseId], references: [id], onDelete: Restrict)
  assetAccount         Account            @relation("ExpenseSettlement_assetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  journal              JournalEntry       @relation("ExpenseSettlement_journal", fields: [journalId], references: [id], onDelete: Restrict)
  reversedSettlement   ExpenseSettlement? @relation("ExpenseSettlement_reversedSettlement", fields: [reversedSettlementId], references: [id], onDelete: Restrict)
  reversal             ExpenseSettlement? @relation("ExpenseSettlement_reversedSettlement")
}

model ReplacementCharge {
  id            String            @id @default(uuid()) @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  kind          String
  treatment     String
  payer         String
  amount        Decimal           @db.Decimal(20, 2)
  replacementId String            @db.Uuid
  journalId     String?           @unique @db.Uuid
  replacement   ReplacementRecord @relation("ReplacementCharge_replacement", fields: [replacementId], references: [id], onDelete: Restrict)
  journal       JournalEntry?     @relation("ReplacementCharge_journal", fields: [journalId], references: [id], onDelete: Restrict)
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  operation      String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  sourceId       String   @db.Uuid
  actorId        String   @db.Uuid
  actor          User     @relation("IdempotencyRecord_actor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
}

model ApplicationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  key         String   @unique
  version     Int      @default(1)
  value       Json
  changedById String   @db.Uuid
  changedBy   User     @relation("ApplicationSetting_changedBy", fields: [changedById], references: [id], onDelete: Restrict)
}

model DocumentSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  sourceType  String
  sourceId    String   @db.Uuid
  kind        String
  version     Int
  snapshot    Json
  artifactKey String?
  checksum    String?

  @@unique([sourceType, sourceId, kind, version])
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  type          String
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
}
