// Phase 2 foundation. Business command handlers are delivered in later phases.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum TrackingKind {
  BATTERY_UNIT
  QUANTITY
}

enum IdentificationMethod {
  SERIAL
  PRODUCTION_DATE
  BOTH
}

enum BatteryCondition {
  PENDING_INSPECTION
  GOOD
  FAULTY
  SCRAP
}

enum Custody {
  SHOP
  CUSTOMER
  SUPPLIER
  DISPOSED
}

enum Ownership {
  SHOP
  CUSTOMER
  DISPOSED
}

enum CommercialState {
  AVAILABLE
  RESERVED
  UNAVAILABLE
  SOLD
  RETIRED
}

enum StockOrigin {
  PURCHASE
  REPLACEMENT
  RETURN
  OPENING
  ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum ReplacementSource {
  BEFORE_SALE
  CUSTOMER_WARRANTY
}

enum ReplacementStatus {
  PENDING_RETURN
  SENT_TO_COMPANY
  UNDER_REVIEW
  REPLACEMENT_RECEIVED
  READY_FOR_CUSTOMER_DELIVERY
  COMPLETED
  REJECTED
}

enum AccountKind {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  OTHER
}

model User {
  id                                  String                          @id @default(uuid()) @db.Uuid
  createdAt                           DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                           DateTime                        @updatedAt @db.Timestamptz(3)
  name                                String
  login                               String                          @unique
  passwordHash                        String
  active                              Boolean                         @default(true)
  passwordChangedAt                   DateTime                        @default(now()) @db.Timestamptz(3)
  version                             Int                             @default(1)
  sessions                            Session[]                       @relation("Session_user")
  roles                               UserRole[]                      @relation("UserRole_user")
  auditLogs                           AuditLog[]                      @relation("AuditLog_actor")
  postings                            Posting[]                       @relation("Posting_actor")
  purchaseRemainderCancellation_actor PurchaseRemainderCancellation[] @relation("PurchaseRemainderCancellation_actor")
  inspections                         BatteryInspection[]             @relation("BatteryInspection_inspector")
  idempotencyRecords                  IdempotencyRecord[]             @relation("IdempotencyRecord_actor")
  settingsChanges                     ApplicationSetting[]            @relation("ApplicationSetting_changedBy")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  tokenHash     String    @unique
  csrfTokenHash String
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  userId        String    @db.Uuid
  user          User      @relation("Session_user", fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  code        String           @unique
  name        String
  builtIn     Boolean          @default(true)
  users       UserRole[]       @relation("UserRole_role")
  permissions RolePermission[] @relation("RolePermission_role")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  code      String           @unique
  name      String
  roles     RolePermission[] @relation("RolePermission_permission")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  user      User     @relation("UserRole_user", fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation("UserRole_role", fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation("RolePermission_role", fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation("RolePermission_permission", fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
}

model LoginAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  key             String   @unique
  count           Int      @default(0)
  windowStartedAt DateTime @default(now()) @db.Timestamptz(3)
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  action       String
  resourceType String
  resourceId   String?
  reason       String?
  requestId    String
  metadata     Json     @default("{}")
  actorId      String?  @db.Uuid
  actor        User?    @relation("AuditLog_actor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model ProductType {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  code         String       @unique
  name         String
  trackingKind TrackingKind
  active       Boolean      @default(true)
  products     Product[]    @relation("Product_type")
  categories   ProductTypeCategory[]
  suppliers    Supplier[]
}

model Brand {
  id             String     @id @default(uuid()) @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  name           String
  normalizedName String     @unique
  active         Boolean    @default(true)
  products       Product[]  @relation("Product_brand")
  suppliers      Supplier[] @relation("Supplier_brand")
}

model Category {
  id             String     @id @default(uuid()) @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  name           String
  normalizedName String     @unique
  active         Boolean    @default(true)
  parentId       String?    @db.Uuid
  parent         Category?  @relation("Category_parent", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("Category_parent")
  products       Product[]  @relation("Product_category")
  types          ProductTypeCategory[]
}

model ProductTypeCategory {
  typeId     String      @db.Uuid
  categoryId String      @db.Uuid
  type       ProductType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([typeId, categoryId])
}

model Product {
  id                          String                @id @default(uuid()) @db.Uuid
  createdAt                   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime              @updatedAt @db.Timestamptz(3)
  name                        String
  model                       String
  identityKey                 String                @unique
  description                 String?
  unit                        String
  active                      Boolean               @default(true)
  defaultSellingPrice         Decimal               @default(0) @db.Decimal(20, 2)
  defaultPurchasePrice        Decimal?              @db.Decimal(20, 2)
  lowStockThreshold           Decimal               @default(0) @db.Decimal(18, 3)
  version                     Int                   @default(1)
  typeId                      String                @db.Uuid
  brandId                     String?               @db.Uuid
  categoryId                  String?               @db.Uuid
  type                        ProductType           @relation("Product_type", fields: [typeId], references: [id], onDelete: Restrict)
  brand                       Brand?                @relation("Product_brand", fields: [brandId], references: [id], onDelete: Restrict)
  category                    Category?             @relation("Product_category", fields: [categoryId], references: [id], onDelete: Restrict)
  batteryDetail               BatteryProductDetail? @relation("BatteryProductDetail_product")
  partsDetail                 PartsProductDetail?   @relation("PartsProductDetail_product")
  purchaseItems               PurchaseItem[]        @relation("PurchaseItem_product")
  batches                     StockBatch[]          @relation("StockBatch_product")
  batteryUnits                BatteryUnit[]         @relation("BatteryUnit_product")
  movements                   StockMovement[]       @relation("StockMovement_product")
  stockAdjustmentItem_product StockAdjustmentItem[] @relation("StockAdjustmentItem_product")
  warrantyPolicies            WarrantyPolicy[]      @relation("WarrantyPolicy_product")
  saleItems                   SaleItem[]            @relation("SaleItem_product")

  @@index([active, name])
}

model BatteryProductDetail {
  id                    String               @id @default(uuid()) @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  capacityAh            Decimal?             @db.Decimal(10, 2)
  voltage               Decimal?             @db.Decimal(10, 2)
  identificationMethod  IdentificationMethod
  defaultWarrantyMonths Int                  @default(0)
  productId             String               @unique @db.Uuid
  product               Product              @relation("BatteryProductDetail_product", fields: [productId], references: [id], onDelete: Restrict)
}

model PartsProductDetail {
  id                    String   @id @default(uuid()) @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  specifications        String?
  defaultWarrantyMonths Int      @default(0)
  productId             String   @unique @db.Uuid
  product               Product  @relation("PartsProductDetail_product", fields: [productId], references: [id], onDelete: Restrict)
}

model Supplier {
  id                  String                @id @default(uuid()) @db.Uuid
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  name                String
  company             String?
  phone               String?
  address             String?
  active              Boolean               @default(true)
  version             Int                   @default(1)
  productTypeId       String?               @db.Uuid
  productType         ProductType?          @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  brandId             String?               @db.Uuid
  brand               Brand?                @relation("Supplier_brand", fields: [brandId], references: [id], onDelete: Restrict)
  purchases           Purchase[]            @relation("Purchase_supplier")
  warrantyPolicies    WarrantyPolicy[]      @relation("WarrantyPolicy_supplier")
  returns             SupplierReturn[]      @relation("SupplierReturn_supplier")
  replacements        ReplacementRecord[]   @relation("ReplacementRecord_supplier")
  dispatches          ReplacementDispatch[] @relation("ReplacementDispatch_supplier")
  replacementReceipts ReplacementReceipt[]  @relation("ReplacementReceipt_supplier")
  journalLines        JournalLine[]         @relation("JournalLine_supplier")
  payments            Payment[]             @relation("Payment_supplier")

  @@index([phone])
  @@index([productTypeId])
}

model Customer {
  id                    String                @id @default(uuid()) @db.Uuid
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  name                  String
  phone                 String
  address               String?
  active                Boolean               @default(true)
  version               Int                   @default(1)
  vehicles              Vehicle[]             @relation("Vehicle_customer")
  batterySets           BatterySet[]          @relation("BatterySet_customer")
  reservedUnits         BatteryUnit[]         @relation("BatteryUnit_reservedCustomer")
  sales                 Sale[]                @relation("Sale_customer")
  warrantyClaims        WarrantyClaim[]       @relation("WarrantyClaim_customer")
  replacements          ReplacementRecord[]   @relation("ReplacementRecord_reservedCustomer")
  replacementDeliveries ReplacementDelivery[] @relation("ReplacementDelivery_customer")
  journalLines          JournalLine[]         @relation("JournalLine_customer")
  payments              Payment[]             @relation("Payment_customer")

  @@index([phone])
}

model Vehicle {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  type        String
  identifier  String?
  notes       String?
  active      Boolean      @default(true)
  customerId  String       @db.Uuid
  customer    Customer     @relation("Vehicle_customer", fields: [customerId], references: [id], onDelete: Restrict)
  batterySets BatterySet[] @relation("BatterySet_vehicle")
  sales       Sale[]       @relation("Sale_vehicle")

  @@unique([customerId, identifier])
}

model BatterySet {
  id         String     @id @default(uuid()) @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)
  label      String
  customerId String     @db.Uuid
  vehicleId  String?    @db.Uuid
  customer   Customer   @relation("BatterySet_customer", fields: [customerId], references: [id], onDelete: Restrict)
  vehicle    Vehicle?   @relation("BatterySet_vehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  units      SaleUnit[] @relation("SaleUnit_batterySet")
}

model Posting {
  id                  String                   @id @default(uuid()) @db.Uuid
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  kind                String
  sourceCode          String                   @unique
  reason              String?
  actorId             String                   @db.Uuid
  actor               User                     @relation("Posting_actor", fields: [actorId], references: [id], onDelete: Restrict)
  purchaseReceipt     PurchaseReceipt?         @relation("PurchaseReceipt_posting")
  movements           StockMovement[]          @relation("StockMovement_posting")
  stockAdjustment     StockAdjustment?         @relation("StockAdjustment_posting")
  openingBalance      OpeningBalance?          @relation("OpeningBalance_posting")
  sale                Sale?                    @relation("Sale_posting")
  salesReturn         SalesReturn?             @relation("SalesReturn_posting")
  supplierReturn      SupplierReturn?          @relation("SupplierReturn_posting")
  replacementDispatch ReplacementDispatch?     @relation("ReplacementDispatch_posting")
  replacementReceipt  ReplacementReceipt?      @relation("ReplacementReceipt_posting")
  replacementDelivery ReplacementDelivery?     @relation("ReplacementDelivery_posting")
  replacementOutcome  ReplacementOutcomeEvent? @relation("ReplacementOutcomeEvent_posting")
  journal             JournalEntry?            @relation("JournalEntry_posting")
}

model Purchase {
  id                                     String                          @id @default(uuid()) @db.Uuid
  createdAt                              DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                              DateTime                        @updatedAt @db.Timestamptz(3)
  number                                 String                          @unique
  supplierReference                      String?
  status                                 PurchaseStatus                  @default(DRAFT)
  orderDate                              DateTime                        @db.Date
  discount                               Decimal                         @default(0) @db.Decimal(20, 2)
  additionalCosts                        Decimal                         @default(0) @db.Decimal(20, 2)
  costPlan                               Json                            @default("{}")
  remainderCancelledAt                   DateTime?                       @db.Timestamptz(3)
  version                                Int                             @default(1)
  supplierId                             String                          @db.Uuid
  supplier                               Supplier                        @relation("Purchase_supplier", fields: [supplierId], references: [id], onDelete: Restrict)
  items                                  PurchaseItem[]                  @relation("PurchaseItem_purchase")
  purchaseRemainderCancellation_purchase PurchaseRemainderCancellation[] @relation("PurchaseRemainderCancellation_purchase")
  receipts                               PurchaseReceipt[]               @relation("PurchaseReceipt_purchase")

  @@index([supplierId, orderDate])
}

model PurchaseItem {
  id                                         String                          @id @default(uuid()) @db.Uuid
  createdAt                                  DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                                  DateTime                        @updatedAt @db.Timestamptz(3)
  lineNumber                                 Int
  quantity                                   Decimal                         @db.Decimal(18, 3)
  unitPrice                                  Decimal                         @default(0) @db.Decimal(20, 2)
  allocatedDiscount                          Decimal                         @default(0) @db.Decimal(20, 2)
  allocatedCosts                             Decimal                         @default(0) @db.Decimal(20, 2)
  expectedUnitCost                           Decimal                         @default(0) @db.Decimal(20, 6)
  purchaseId                                 String                          @db.Uuid
  productId                                  String                          @db.Uuid
  purchase                                   Purchase                        @relation("PurchaseItem_purchase", fields: [purchaseId], references: [id], onDelete: Restrict)
  product                                    Product                         @relation("PurchaseItem_product", fields: [productId], references: [id], onDelete: Restrict)
  purchaseRemainderCancellation_purchaseItem PurchaseRemainderCancellation[] @relation("PurchaseRemainderCancellation_purchaseItem")
  receipts                                   PurchaseReceiptItem[]           @relation("PurchaseReceiptItem_purchaseItem")

  @@unique([purchaseId, lineNumber])
}

model PurchaseRemainderCancellation {
  id             String       @id @default(uuid()) @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  quantity       Decimal      @db.Decimal(18, 3)
  reason         String
  purchaseId     String       @db.Uuid
  purchaseItemId String       @db.Uuid
  actorId        String       @db.Uuid
  purchase       Purchase     @relation("PurchaseRemainderCancellation_purchase", fields: [purchaseId], references: [id], onDelete: Restrict)
  purchaseItem   PurchaseItem @relation("PurchaseRemainderCancellation_purchaseItem", fields: [purchaseItemId], references: [id], onDelete: Restrict)
  actor          User         @relation("PurchaseRemainderCancellation_actor", fields: [actorId], references: [id], onDelete: Restrict)
}

model PurchaseReceipt {
  id                 String                @id @default(uuid()) @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  number             String                @unique
  receivedDate       DateTime              @db.Date
  postedAt           DateTime              @default(now()) @db.Timestamptz(3)
  purchaseId         String                @db.Uuid
  postingId          String                @unique @db.Uuid
  purchase           Purchase              @relation("PurchaseReceipt_purchase", fields: [purchaseId], references: [id], onDelete: Restrict)
  posting            Posting               @relation("PurchaseReceipt_posting", fields: [postingId], references: [id], onDelete: Restrict)
  items              PurchaseReceiptItem[] @relation("PurchaseReceiptItem_receipt")
  paymentAllocations PaymentAllocation[]   @relation("PaymentAllocation_purchaseReceipt")

  @@index([purchaseId, postedAt])
}

model PurchaseReceiptItem {
  id             String               @id @default(uuid()) @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  quantity       Decimal              @db.Decimal(18, 3)
  netCost        Decimal              @default(0) @db.Decimal(20, 2)
  receiptId      String               @db.Uuid
  purchaseItemId String               @db.Uuid
  receipt        PurchaseReceipt      @relation("PurchaseReceiptItem_receipt", fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseItem   PurchaseItem         @relation("PurchaseReceiptItem_purchaseItem", fields: [purchaseItemId], references: [id], onDelete: Restrict)
  batch          StockBatch?          @relation("StockBatch_receiptItem")
  returns        SupplierReturnItem[] @relation("SupplierReturnItem_receiptItem")

  @@unique([receiptId, purchaseItemId])
}

model StockBatch {
  id                                String                  @id @default(uuid()) @db.Uuid
  createdAt                         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime                @updatedAt @db.Timestamptz(3)
  origin                            StockOrigin
  originalQuantity                  Decimal                 @db.Decimal(18, 3)
  unitCost                          Decimal                 @default(0) @db.Decimal(20, 6)
  acquiredAt                        DateTime                @default(now()) @db.Timestamptz(3)
  productId                         String                  @db.Uuid
  receiptItemId                     String?                 @unique @db.Uuid
  replacementReceiptItemId          String?                 @unique @db.Uuid
  openingItemId                     String?                 @unique @db.Uuid
  adjustmentItemId                  String?                 @unique @db.Uuid
  returnItemId                      String?                 @unique @db.Uuid
  product                           Product                 @relation("StockBatch_product", fields: [productId], references: [id], onDelete: Restrict)
  receiptItem                       PurchaseReceiptItem?    @relation("StockBatch_receiptItem", fields: [receiptItemId], references: [id], onDelete: Restrict)
  replacementReceiptItem            ReplacementReceiptItem? @relation("StockBatch_replacementReceiptItem", fields: [replacementReceiptItemId], references: [id], onDelete: Restrict)
  openingItem                       OpeningBalanceItem?     @relation("StockBatch_openingItem", fields: [openingItemId], references: [id], onDelete: Restrict)
  adjustmentItem                    StockAdjustmentItem?    @relation("StockBatch_adjustmentItem", fields: [adjustmentItemId], references: [id], onDelete: Restrict)
  returnItem                        SalesReturnItem?        @relation("StockBatch_returnItem", fields: [returnItemId], references: [id], onDelete: Restrict)
  batteryUnits                      BatteryUnit[]           @relation("BatteryUnit_batch")
  balances                          InventoryBalance[]      @relation("InventoryBalance_batch")
  movements                         StockMovement[]         @relation("StockMovement_batch")
  stockAdjustmentItem_originalBatch StockAdjustmentItem[]   @relation("StockAdjustmentItem_originalBatch")
  costAllocations                   CostAllocation[]        @relation("CostAllocation_batch")

  @@index([productId, acquiredAt])
}

model BatteryUnit {
  id                              String                   @id @default(uuid()) @db.Uuid
  createdAt                       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                 @updatedAt @db.Timestamptz(3)
  internalCode                    String                   @unique
  serialNumber                    String?
  normalizedSerial                String?
  productionDate                  DateTime?                @db.Date
  condition                       BatteryCondition         @default(PENDING_INSPECTION)
  custody                         Custody                  @default(SHOP)
  ownership                       Ownership                @default(SHOP)
  commercialState                 CommercialState          @default(UNAVAILABLE)
  origin                          StockOrigin
  version                         Int                      @default(1)
  productId                       String                   @db.Uuid
  batchId                         String                   @db.Uuid
  reservedCustomerId              String?                  @db.Uuid
  reservedReplacementId           String?                  @db.Uuid
  product                         Product                  @relation("BatteryUnit_product", fields: [productId], references: [id], onDelete: Restrict)
  batch                           StockBatch               @relation("BatteryUnit_batch", fields: [batchId], references: [id], onDelete: Restrict)
  reservedCustomer                Customer?                @relation("BatteryUnit_reservedCustomer", fields: [reservedCustomerId], references: [id], onDelete: Restrict)
  reservedReplacement             ReplacementRecord?       @relation("BatteryUnit_reservedReplacement", fields: [reservedReplacementId], references: [id], onDelete: Restrict)
  movements                       StockMovement[]          @relation("StockMovement_batteryUnit")
  stockAdjustmentItem_batteryUnit StockAdjustmentItem[]    @relation("StockAdjustmentItem_batteryUnit")
  saleHistory                     SaleUnit[]               @relation("SaleUnit_batteryUnit")
  costAllocations                 CostAllocation[]         @relation("CostAllocation_batteryUnit")
  salesReturnItem_batteryUnit     SalesReturnItem[]        @relation("SalesReturnItem_batteryUnit")
  supplierReturnItem_batteryUnit  SupplierReturnItem[]     @relation("SupplierReturnItem_batteryUnit")
  warrantyClaims                  WarrantyClaim[]          @relation("WarrantyClaim_faultyUnit")
  replacementCases                ReplacementRecord[]      @relation("ReplacementRecord_oldUnit")
  inspections                     BatteryInspection[]      @relation("BatteryInspection_batteryUnit")
  dispatchItem_oldUnit            DispatchItem[]           @relation("DispatchItem_oldUnit")
  replacedBy                      ReplacementReceiptItem[] @relation("ReplacementReceiptItem_oldUnit")
  replacementOrigin               ReplacementReceiptItem?  @relation("ReplacementReceiptItem_newUnit")
  delivery                        ReplacementDelivery?     @relation("ReplacementDelivery_newUnit")

  @@unique([productId, normalizedSerial])
  @@index([productionDate])
  @@index([productId, commercialState, custody, condition, ownership])
}

model InventoryBalance {
  id        String          @id @default(uuid()) @db.Uuid
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  location  String
  bucket    CommercialState
  quantity  Decimal         @db.Decimal(18, 3)
  batchId   String          @db.Uuid
  batch     StockBatch      @relation("InventoryBalance_batch", fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, location, bucket])
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  lineNumber         Int
